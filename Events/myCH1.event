#include EAstdlib.event
EventPointerTable(0xA,Ch1Events)
EscapePointPointerTable(0x1, Ch1EscapePoints)

Ch1EscapePoints:
EscapePoint(15,17,MoveDown)
EscapePointEnd

Ch1Events:
POIN Ch1TurnBasedEvents
POIN Ch1CharacterBasedEvents
POIN Ch1LocationBasedEvents
POIN Ch1MiscBasedEvents
POIN Ch1Dunno Ch1Dunno Ch1Dunno
POIN Ch1Tutorial
POIN Ch1TrapData Ch1TrapData
POIN DaphneParty DaphneParty
POIN $0 $0 $0 $0 $0 $0
POIN Ch1BeginningScene Ch1EndingScene

Ch1TurnBasedEvents:
TurnEventNPC(07,ErnestAppears,2)
//TurnEventPlayer(08,ConditionalSoldier,3)
TurnEventPlayer(09,BigBrawl,4)
//TurnEventPlayer(10,Turn6EnemyReinforcements,6)
//TurnEventPlayer(11,ConditionalThief,10)
END_MAIN
ALIGN 32 //For some reason, CharacterBasedEvents have to be 32-Aligned?

Ch1CharacterBasedEvents:
CharacterEvent(12,NavarroConvo,Daphne,Navarro)
CharacterEventBothWays(13,RecruitErnest,Daphne,Ernest)
CharacterEventBothWays(14,AltoSupply,Daphne,Alto)
CharacterEventBothWays(15,KanSupply,Daphne,Kan)
END_MAIN

Ch1LocationBasedEvents:
Door(11,5)
Village(16,HandAxeHouse,7,15)
House(17,InnConvo,3,16)
Armory(ch1Armory,2,6)
Vendor(ch1Shop,1,9)
END_MAIN

Ch1MiscBasedEvents:
CauseGameOverIfLordDies
DefeatAll(NowTalkToNavarro)
END_MAIN

Ch1Dunno:
END_MAIN

Ch1Tutorial:
END_MAIN

Ch1TrapData:
ENDTRAP

