#include EAstdlib.event
EventPointerTable(0x7,PThirdParties)

PThirdParties:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN Dunno Dunno Dunno
POIN Tutorial
POIN TrapData TrapData
POIN ActualPlayerUnits ActualPlayerUnits //these pointers are just for prep screen unit placement
POIN $0 $0 $0 $0 $0 $0
POIN PBeginningScene PEndingScene

TurnBasedEvents:
TurnEventPlayer(07,ShadowLeaves,4)
TurnEventPlayer(08,BensonAppears,5)
TurnEventPlayer(09,MorrisYells,6)
TurnEventPlayer(10,ImpatientMorris,7)
END_MAIN
ALIGN 32 //For some reason, CharacterBasedEvents have to be 32-Aligned?

CharacterBasedEvents:
END_MAIN

LocationBasedEvents:
END_MAIN

MiscBasedEvents:
CauseGameOverIfLordDies
DefeatBoss(PEndingScene)
AREA 11 timerChange [1, 2] [4, 7]
END_MAIN

Dunno:
END_MAIN

Tutorial:
END_MAIN

TrapData:
ENDTRAP

