#include EAstdlib.event
EventPointerTable(EventTableID,ThisChapter)

ThisChapter:
POIN XXXXTurnBasedEvents
POIN XXXXCharacterBasedEvents
POIN XXXXLocationBasedEvents
POIN XXXXMiscBasedEvents
POIN XXXXDunno XXXXDunno XXXXDunno
POIN XXXXTutorial
POIN XXXXTrapData XXXXTrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN XXXXBeginningScene XXXXEndingScene

XXXXTurnBasedEvents:
END_MAIN
ALIGN 32 //For some reason, XXXXCharacterBasedEvents have to be 32-Aligned?

XXXXCharacterBasedEvents:
END_MAIN

XXXXLocationBasedEvents:
END_MAIN

XXXXMiscBasedEvents:
CauseGameOverIfLordDies
END_MAIN

XXXXDunno:
END_MAIN

XXXXTutorial:
END_MAIN

XXXXTrapData:
ENDTRAP

ALIGN 4

Units:
UNIT

XXXXBeginningScene:
ENDA

XXXXEndingScene:
MoveToChapter(NextChapter)
ENDA

MESSAGE Events end at offset CURRENTOFFSET