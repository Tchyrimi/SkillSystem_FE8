//mercenary weapon type fix
Mercenary_ManimPointer:
AddClassAnimation(0x0B,Swords,0x1)
AddClassAnimation(0x0C,Disarmed,0x1)
EndClassAnimation

// Opportunist Anims
LanceMercAnimPointer:
AddClassAnimation(0xCA,Lances,0x1)
AddClassAnimation(0xCB,Disarmed,0x1)
EndClassAnimation


//Brawler Anims
BrawlerAnimPointer:
AddClassAnimation(0xCC,Axes,0x1)
AddHandAxeAnimation(0xCD)
AddClassAnimation(0xCE,Disarmed,0x1)
EndClassAnimation


//Mender Anims
MenderAnimPointer:
AddClassAnimation(0xCF,Swords,0x1)
AddClassAnimation(0xD0,Staves,0x1)
AddClassAnimation(0xD1,Disarmed,0x1)
EndClassAnimation


//Conduit Anims
ConduitAnimPointer:
AddClassAnimation(0xD2,Anima,0x1)
EndClassAnimation

//Vagabond Anims
VagabondAnimPointer:
AddClassAnimation(0xD3,Swords,0x1)
AddClassAnimation(0xD4,Disarmed,0x1)
EndClassAnimation